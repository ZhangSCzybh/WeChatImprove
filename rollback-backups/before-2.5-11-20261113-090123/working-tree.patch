+static void InstallCallNotifications(void) {
+    for(NSString *name in @[@"showLocalNotificationWithMsg:repeatVibration:",
+        @"showLocalNotificationWithMsg:repeatVibration:silently:",
+        @"showLocalNotificationByIlinkWithMsg:repeatVibration:isCallkitAvailable:"]) {
+        __block IMP original=NULL;SEL selector=NSSelectorFromString(name);
+        BOOL extended=![name isEqual:@"showLocalNotificationWithMsg:repeatVibration:"];
+        IMP replacement=extended ? imp_implementationWithBlock(^(id owner,id message,BOOL repeat,BOOL option) {
+            CSCFCallDiagnosticsRecord([name hasPrefix:@"showLocalNotificationByIlink"]?@"mono.ilink":@"mono.three",CSCloseFriendAccountEpoch());
+            CSCFPerformCallNotification(message,^{((void(*)(id,SEL,id,BOOL,BOOL))original)(owner,selector,message,repeat,option);});
+        }) : imp_implementationWithBlock(^(id owner,id message,BOOL repeat) {
+            CSCFCallDiagnosticsRecord(@"mono.two",CSCloseFriendAccountEpoch());
+            CSCFPerformCallNotification(message,^{((void(*)(id,SEL,id,BOOL))original)(owner,selector,message,repeat);});
+        });
+        if(!CSCloseFriendInstallHook(@"MonoServiceMsgMgr",name,replacement,&original,extended?"v@:@BB":"v@:@B"))imp_removeBlock(replacement);
+    }
+    // CAppUtil preserves its own conversion and main-thread dispatch. Its public
+    // handler receives MMNotificationSetting, not UNNotificationSettings.
+    Class utility=NSClassFromString(@"CAppUtil");SEL settings=NSSelectorFromString(@"GetEnabledNotificationSettingWithCompletionHandler:");
+    if(CSCloseFriendMethodMatches(class_getClassMethod(utility,settings),"v@:@?")) {
+        __block IMP original=NULL;
+        IMP replacement=imp_implementationWithBlock(^(id owner,CSCloseFriendNotificationSettingsCompletion completion) {
+            ((void(*)(id,SEL,CSCloseFriendNotificationSettingsCompletion))original)(owner,settings,CSCFCallNotificationCompletion(completion));
+        });
+        MSHookMessageEx(object_getClass(utility),settings,replacement,&original);
+        CSCloseFriendRecordCapability(@"calls.notifications.settingsCallback",original!=NULL);
+    } else CSCloseFriendRecordCapability(@"calls.notifications.settingsCallback",NO);
+}
