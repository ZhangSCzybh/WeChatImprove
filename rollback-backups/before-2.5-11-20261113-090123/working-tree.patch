+    static dispatch_once_t once;
+    dispatch_once(&once,^{
+        NSDictionary *events=@{UIApplicationDidEnterBackgroundNotification:@"app.background",
+            UIApplicationWillEnterForegroundNotification:@"app.foreground",UIApplicationDidBecomeActiveNotification:@"app.active",
