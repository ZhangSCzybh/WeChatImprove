+NS_INLINE CSGroupIndicatorAnimationStyle CSGroupIndicatorStyle(NSUserDefaults *defaults) {
+    id value = [defaults objectForKey:CSGroupIndicatorAnimationStyleKey];
+    if ([value isKindOfClass:NSNumber.class]) {
+        double style = [value doubleValue];
+        if (isfinite(style) && floor(style) == style && style >= CSGroupIndicatorAnimationNone && style <= CSGroupIndicatorAnimationArc)
+            return (CSGroupIndicatorAnimationStyle)style;
+    }
+    // Read old preferences without rewriting them during layout or gestures.
+    id stored = [defaults objectForKey:CSGroupIndicatorAnimationEnabledKey];
+    return [stored isKindOfClass:NSNumber.class] && ![stored boolValue] ? CSGroupIndicatorAnimationNone : CSGroupIndicatorAnimationClassic;
+}
+
