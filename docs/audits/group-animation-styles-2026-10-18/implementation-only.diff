+NS_INLINE void CSGroupSetIndicatorStyle(NSUserDefaults *defaults, CSGroupIndicatorAnimationStyle style) {
+    if (style < CSGroupIndicatorAnimationNone || style > CSGroupIndicatorAnimationArc) style = CSGroupIndicatorAnimationClassic;
+    [defaults setInteger:style forKey:CSGroupIndicatorAnimationStyleKey];
+    // Keep downgrades compatible with the original on/off setting.
+    [defaults setBool:style != CSGroupIndicatorAnimationNone forKey:CSGroupIndicatorAnimationEnabledKey];
+}
