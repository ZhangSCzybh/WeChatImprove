+#!/bin/bash
+set -euo pipefail
+project_dir="$(cd "$(dirname "$0")/.." && pwd)"
+test_dir="$(mktemp -d "${TMPDIR:-/tmp}/wechat-automation-diagnostics.XXXXXX")"
+trap 'rm -rf "$test_dir"' EXIT
+python3 - "$project_dir" "$test_dir" <<'PY'
+import sys
+from pathlib import Path
+project, target = map(Path, sys.argv[1:])
+source = (project/'Controllers/CSMessageNativeActionAdapter.m').read_text().split('@interface NSObject (CSNativeAppPath)', 1)[0]
+(target/'NativeDispatchUnderTest.m').write_text(source)
+PY
+xcrun --sdk macosx clang -fobjc-arc -fblocks -Wall -Wextra -Werror \
+  -DCS_AUTODIAG_HOST_TEST=1 -framework Foundation -I"$project_dir/Controllers" \
+  "$project_dir/Controllers/CSAutomationDiagnostics.m" \
+  "$test_dir/NativeDispatchUnderTest.m" \
+  "$project_dir/Tests/AutomationDiagnosticsTests.m" -o "$test_dir/tests"
+"$test_dir/tests"
+xcrun --sdk macosx clang -fobjc-arc -fblocks -Wall -Wextra -Werror \
+  -DCS_AUTODIAG_HOST_TEST=1 -framework Foundation -I"$project_dir/Controllers" \
+  "$project_dir/Controllers/CSAutomationDiagnostics.m" "$test_dir/NativeDispatchUnderTest.m" \
+  "$project_dir/Tests/AutomationReplyDiagnosticsTests.m" -o "$test_dir/reply-tests"
+"$test_dir/reply-tests"
+if [[ "${1:-}" == "--ios" ]]; then
+  sdk_dir="$(xcrun --sdk iphoneos --show-sdk-path)"
+  for arch in arm64 arm64e; do
+    xcrun --sdk iphoneos clang -target "$arch-apple-ios15.0" -isysroot "$sdk_dir" \
