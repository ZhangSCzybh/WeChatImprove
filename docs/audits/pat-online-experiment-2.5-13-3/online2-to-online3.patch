+using Signal = void (*)(bool, const std::string &);
+struct Channel {
+    Signal original = nullptr;
+    uintptr_t backgroundCaller = 0;
+    // Updated on every natural default-context call, including worker threads.
+    // The low bit is the caller's actual foreground intent; upper bits order it.
+    std::atomic<uint64_t> natural{0};
+    uint64_t held = 0; // main-thread only; zero means no override to restore
+    uint64_t foregroundFence = 0;
+    unsigned depth = 0;
+    bool releasePending = false;
+};
+Channel channels[2];
+bool installed = false;
+bool repairQueued[2] = {};
+#if defined(CS_NETWORK_ACTIVITY_TESTING)
+const mach_header_64 *testHeader = nullptr;
