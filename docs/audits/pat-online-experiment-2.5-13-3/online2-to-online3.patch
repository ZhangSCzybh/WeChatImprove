+void record(NSString *stage, unsigned channel, uint64_t flags) {
+    try {
+        @try { CSAutoDiagRecord(stage, 0, CSBackupAccountEpoch(), flags | ((uint64_t)channel << 8)); }
+        @catch (__unused NSException *exception) {}
+    } catch (...) {}
+}
+bool eligible() {
+    if (!NSThread.isMainThread || checkingEligibility) return false;
+    checkingEligibility = true;
+    BOOL result = NO;
+    try {
+        @try { result = CSAutomationOnlineExperimentWantsNetworkActivity(); }
+        @catch (__unused NSException *exception) {}
+    } catch (...) {}
+    checkingEligibility = false;
+    return result;
+}
+uint64_t observe(Channel &channel, bool foreground) {
+    uint64_t previous = channel.natural.load();
+    uint64_t next;
+    do { next = ((previous + 2) & ~1ULL) | (foreground ? 1 : 0); }
+    while (!channel.natural.compare_exchange_weak(previous, next));
+    return next;
+}
+void repair(unsigned index);
+void restore(unsigned index);
+void scheduleRepair(unsigned index) {
+    // Only needed when a natural event overtook one of our synthetic calls.
+    // No timer/poll: coalesce the collision and apply the latest intent once
+    // after the native stack unwinds. A further collision supplies a new wake.
+    if (repairQueued[index]) return;
+    repairQueued[index]=true;
+    dispatch_async(dispatch_get_main_queue(), ^{ repairQueued[index]=false; repair(index); });
+}
+void emitOwned(unsigned index, bool value, uint64_t serial) {
+    Channel &channel=channels[index];
+    channel.depth++;
+    try {
+        @try { channel.original(value, defaultContext); record(@"network.restore.return", index, 1); }
+        @catch (__unused NSException *exception) { record(@"network.restore.return", index, 0); }
+    } catch (...) { record(@"network.restore.return", index, 0); }
+    channel.depth--;
+    if (channel.natural.load()!=serial) scheduleRepair(index);
+    if (!channel.depth && channel.releasePending) restore(index);
+}
+void repair(unsigned index) {
+    Channel &channel=channels[index];
+    if (!channel.original) return;
+    uint64_t serial=channel.natural.load();
+    // A real foreground handoff discards old background intent. A newer native
+    // true must still repair an overtaken false, even when UIKit is now Active.
+    if (serial==channel.foregroundFence && !(serial&1)) return;
+    bool held=channel.held && channel.held==serial && eligible();
+    held=held && channel.held==serial;
+    if (channel.natural.load()!=serial) { scheduleRepair(index); return; }
+    if (serial==channel.foregroundFence && !(serial&1)) return;
+    if (!held) channel.held=0;
+    emitOwned(index,held || (serial&1),serial);
+    record(@"network.reconcile",index,held?1:0);
+}
+void restore(unsigned index) {
+    Channel &channel = channels[index];
+    if (channel.depth) { channel.releasePending = true; return; }
+    channel.releasePending = false;
+    uint64_t held = channel.held;
+    channel.held = 0; // Claim before native code can reenter configuration/lifecycle.
+    if (!held || !channel.original || channel.natural.load() != held) return;
