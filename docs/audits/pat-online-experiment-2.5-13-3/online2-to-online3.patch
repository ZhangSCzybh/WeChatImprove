+        record(@"network.install", 0, 0); return NO;
+    }
+    Signal replacements[2] = {primary, secondary};
+    for (unsigned i=0; i<2; i++) {
+        if (channels[i].original) continue;
+        channels[i].backgroundCaller = target.caller[i];
+        MSHookFunction(reinterpret_cast<void *>(target.entry[i]), reinterpret_cast<void *>(replacements[i]),
+                       reinterpret_cast<void **>(&channels[i].original));
+        if (!channels[i].original) { record(@"network.install", i, 0); return NO; }
+    }
+    installed = true;
+    record(@"network.install", 0, 1); return YES;
+}
+void CSAutomationNetworkActivityRefresh(BOOL keep) {
+    if (!NSThread.isMainThread || keep) return;
+    for (unsigned i=0; i<2; i++) restore(i);
+}
+void CSAutomationNetworkActivityForeground(void) {
+    if (!NSThread.isMainThread) return;
+    for (auto &channel : channels) { channel.held=0; channel.releasePending=false; channel.foregroundFence=channel.natural.load(); }
+}
+void CSAutomationNetworkActivityReport(void) {
+    if (!NSThread.isMainThread) return;
+    for (unsigned i=0; i<2; i++) record(@"network.snapshot", i,
+        (installed ? 1 : 0) | (channels[i].held && channels[i].held==channels[i].natural.load() ? 2 : 0));
+}
