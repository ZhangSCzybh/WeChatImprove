+        header->cputype != CPU_TYPE_ARM64 || header->ncmds > 4096 || header->sizeofcmds > 1024*1024) return false;
+    const uint8_t *cursor = reinterpret_cast<const uint8_t *>(header + 1);
+    const uint8_t *end = cursor + header->sizeofcmds;
+    bool uuid = false;
+    uint64_t textStart = 0, textSize = 0;
+    for (uint32_t i=0; i<header->ncmds; i++) {
+        if (static_cast<size_t>(end-cursor) < sizeof(load_command)) return false;
+        const load_command *command = reinterpret_cast<const load_command *>(cursor);
+        if (command->cmdsize < sizeof(load_command) || command->cmdsize > static_cast<size_t>(end-cursor)) return false;
+        if (command->cmd == LC_UUID && command->cmdsize >= sizeof(uuid_command))
+            uuid = !std::memcmp(reinterpret_cast<const uuid_command *>(command)->uuid, expectedUUID, 16);
+        if (command->cmd == LC_SEGMENT_64 && command->cmdsize >= sizeof(segment_command_64)) {
+            const segment_command_64 *segment = reinterpret_cast<const segment_command_64 *>(command);
+            if (!std::strncmp(segment->segname, "__TEXT", 16) && (segment->initprot & 4)) {
+                textStart=segment->vmaddr; textSize=segment->vmsize;
+            }
+        }
+        cursor += command->cmdsize;
+    }
+    if (!uuid) return false;
+    const uintptr_t entries[2] = {0x1130e6870ULL, 0x10b7439a0ULL};
+    const uintptr_t callers[2] = {0x104e857acULL, 0x104e85804ULL};
+    const uint32_t signatures[2][4] = {{0x90065189,0xf9452529,0xb4000049,0xd61f0120},
+                                      {0xf00a0609,0xf9474529,0xb4000049,0xd61f0120}};
+    const uint32_t callInstructions[2] = {0x94b61ada,0x95a2f868};
+    for (unsigned i=0; i<2; i++) {
+        if (entries[i] < textStart || entries[i]-textStart > textSize ||
+            textSize-(entries[i]-textStart) < sizeof(signatures[i]) || callers[i]-4 < textStart ||
+            callers[i]-4-textStart > textSize || textSize-(callers[i]-4-textStart) < 4) return false;
+        target.entry[i] = static_cast<uintptr_t>(slide) + entries[i];
+        target.caller[i] = static_cast<uintptr_t>(slide) + callers[i];
+        if (std::memcmp(reinterpret_cast<const void *>(target.entry[i]), signatures[i], sizeof(signatures[i])) ||
+            std::memcmp(reinterpret_cast<const void *>(target.caller[i]-4), &callInstructions[i], 4)) return false;
+    }
+    return true;
+}
