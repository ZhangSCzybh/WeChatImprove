+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+test_dir=$(mktemp -d "${TMPDIR:-/tmp}/wechat-network-activity.XXXXXX")
+trap 'rm -rf "$test_dir"' EXIT
+cat > "$test_dir/substrate.h" <<'HEADER'
+#ifdef __cplusplus
+extern "C" {
+#endif
+void MSHookFunction(void *,void *,void **);
+#ifdef __cplusplus
+}
+#endif
+HEADER
+xcrun --sdk macosx clang++ -std=c++17 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions \
+ -Wall -Wextra -Werror -DCS_NETWORK_ACTIVITY_TESTING=1 \
+ -I"$test_dir" -ITests/AIDetailUIKit -IControllers -framework Foundation \
+ Controllers/CSAutomationNetworkActivity.mm Tests/AutomationNetworkActivityTests.mm -o "$test_dir/tests"
+"$test_dir/tests"
+if [[ "${1:-}" == "--ios" ]]; then
+ sdk_dir=$(xcrun --sdk iphoneos --show-sdk-path)
+ for arch in arm64 arm64e; do
+  xcrun --sdk iphoneos clang++ -std=c++17 -target "$arch-apple-ios15.0" -isysroot "$sdk_dir" \
+   -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -Wall -Wextra -Werror \
+   -I"$test_dir" -IControllers -c Controllers/CSAutomationNetworkActivity.mm -o "$test_dir/network-activity.$arch.o"
+ done
+ printf 'Automation network activity iOS: arm64 + arm64e production objects compiled\n'
+fi
