+    @try { channel.original(override ? true : foreground, context); returned=true; }
+    @finally {
+        channel.depth--;
+        if (override && channel.natural.load()!=serial) scheduleRepair(index);
+        if (!returned && override) channel.releasePending=true;
+        if (channel.held && (channel.releasePending || !eligible())) {
+            // The observed native false is authoritative during the transition;
+            // UIKit can still report Active. An explicit foreground handoff
+            // already clears held before this restoration can be requested.
+            restore(index);
+        }
+    }
+}
