+bool targetForHeader(const mach_header_64 *header, intptr_t slide, Target &target) {
+    static const uint8_t expectedUUID[16] = {0x7e,0x4a,0x81,0x71,0x5a,0xcc,0x3a,0x72,0xa7,0x6a,0x3a,0xce,0x52,0xd3,0xd8,0x95};
