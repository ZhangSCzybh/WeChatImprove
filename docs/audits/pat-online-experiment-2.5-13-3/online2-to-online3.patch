+    // do not manufacture a natural event or touch the other transport channel.
+    emitOwned(index,false,held);
+}
+void receive(unsigned index, bool foreground, const std::string &context, uintptr_t caller) {
+    Channel &channel = channels[index];
+    if (!channel.original) return;
+    if (context != defaultContext) { channel.original(foreground, context); return; }
+    uint64_t serial = observe(channel, foreground);
+    if (!NSThread.isMainThread) { channel.original(foreground, context); return; }
