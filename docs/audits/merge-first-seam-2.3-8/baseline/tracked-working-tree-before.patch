+        ],
+        @"2.3-6": @[
+            @{@"title": @"修复转账修改金额入口", @"detail": @"根据 2.3-5 的实际使用反馈，兼容转账标题中的纯数字、千分位与币种格式，避免金额识别失败时过滤“修改金额”菜单；继续保留消息类型与当前会话校验。"},
+            @{@"title": @"保留系统时间点击切换", @"detail": @"修改系统时间后保留微信原生点击响应；简略与包含星期的详细格式均按替换后的日期显示，并随当前聊天的原生时间模式一起切换。离开聊天后恢复原显示。"},
+            @{@"title": @"修正版验证范围", @"detail": @"本轮依据真实 UIKit 检查与微信 8.0.80 原生接口静态证据调整展示逻辑。替换仍仅存在当前聊天的本机内存中；2.3-6 尚待 iPhone 微信复验，主机与 Mac Catalyst 检查不能替代真机验收。"}
