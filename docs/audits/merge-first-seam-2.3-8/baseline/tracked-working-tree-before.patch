+        @"2.3-7": @[
+            @{@"title": @"统一显示昵称时的合并间距", @"detail": @"紧密模式跟随微信当前昵称、字体和样式布局计算正文位置，保留群昵称，让普通连续消息的组内接缝保持一致。"},
