@@ -0,0 +1,38 @@
+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+test_dir=$(mktemp -d "${TMPDIR:-/tmp}/wechat-online-experiment.XXXXXX")
+trap 'rm -rf "$test_dir"' EXIT
+python3 - "$test_dir" <<'PY'
+from pathlib import Path
+import sys
+target=Path(sys.argv[1])
+native=Path('Controllers/CSMessageNativeActionAdapter.m').read_text()
+prefix=native.split('@interface NSObject (CSNativeAppPath)',1)[0]
+environment='@implementation CSMessageNativeEnvironment'+native.split('@implementation CSMessageNativeEnvironment',1)[1].split('@implementation CSMessageNativeActionAdapter',1)[0]
+(target/'NativeEnvironmentUnderTest.m').write_text(prefix+'\n'+environment)
+(target/'substrate.h').write_text('#import <objc/runtime.h>\nvoid MSHookMessageEx(Class, SEL, IMP, IMP *);\n')
+PY
+xcrun --sdk macosx clang -fobjc-arc -fblocks -Wall -Wextra -Werror \
+ -Wno-incomplete-implementation -I"$test_dir" -ITests/AIDetailUIKit -IControllers -IHeaders -framework Foundation \
+ Controllers/CSMessageActionContext.m "$test_dir/NativeEnvironmentUnderTest.m" \
+ Controllers/CSAutomationOnlineExperiment.m Tests/AutomationDiagnosticsInactiveStub.m \
+ Tests/AutomationOnlineExperimentTests.m -o "$test_dir/tests"
+if [[ "${1:-}" != "--abi-only" ]]; then "$test_dir/tests"; fi
+if [[ "${1:-}" != "--main-only" ]]; then
+for mode in version class-missing selector-missing result-B argument-I argument-q argument-object count-zero count-extra \
+ longlink-missing longlink-result-B longlink-argument-i longlink-count \
+ sendonly-missing sendonly-result-B sendonly-argument-i sendonly-count \
+ perform-result-B perform-selector-object perform-object-i perform-wait-I perform-count; do
+ "$test_dir/tests" "$mode"
+done
+fi
+if [[ "${1:-}" == "--ios" ]]; then
+ sdk_dir=$(xcrun --sdk iphoneos --show-sdk-path)
+ for arch in arm64 arm64e; do
+  xcrun --sdk iphoneos clang -target "$arch-apple-ios15.0" -isysroot "$sdk_dir" \
+   -fobjc-arc -fblocks -Wall -Wextra -Werror -I"$test_dir" -IControllers -IHeaders \
+   -c Controllers/CSAutomationOnlineExperiment.m -o "$test_dir/online-experiment.$arch.o"
+ done
+ printf 'Automation online experiment iOS: arm64 + arm64e production objects compiled\n'
+fi
