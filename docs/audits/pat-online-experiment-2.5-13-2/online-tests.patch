@@ -0,0 +1,46 @@
+#!/bin/bash
+set -euo pipefail
+project_dir="$(cd "$(dirname "$0")/.." && pwd)"
+test_dir="$(mktemp -d "${TMPDIR:-/tmp}/wechat-pat-diagnostic-integration.XXXXXX")"
+trap 'rm -rf "$test_dir"' EXIT
+python3 - "$project_dir" "$test_dir" <<'PY'
+from pathlib import Path
+import sys
+root, output = map(Path, sys.argv[1:])
+source=(root/'Controllers/CSMessageNativeActionAdapter.m').read_text().split('@interface NSObject (CSNativeAppPath)',1)[0]
+(output/'NativeDispatchUnderTest.m').write_text(source)
+source=(root/'Controllers/CSAutomationEventAdapter.m').read_text()
+original='CSAutomationFileURL([library URLByAppendingPathComponent:@"Preferences/WeChatImprove"],account)'
+assert source.count(original)==1
+source=source.replace(original,'CSAutomationFileURL([NSURL fileURLWithPath:NSProcessInfo.processInfo.environment[@"CS_AUTOMATION_TEST_ROOT"]],account)').replace('NSURL *library=[NSFileManager.defaultManager URLsForDirectory:NSLibraryDirectory inDomains:NSUserDomainMask].firstObject;','')
+(output/'EventAdapterUnderTest.m').write_text(source)
+source=(root/'Hooks/AutomationHooks.xm').read_text().split('%ctor {',1)[0].replace('"../Controllers/','"')
+(output/'AutomationIngressUnderTest.m').write_text(source+'\nvoid CSAutomationTestInstallIngressHooks(void){CSAutomationInstallIngressHooks();}\n')
+(output/'substrate.h').write_text('#import <objc/runtime.h>\nvoid MSHookMessageEx(Class, SEL, IMP, IMP *);\n')
+source=(root/'Tests/AutomationPatIngressTests.m').read_text()
+manager_fixture=(root/'Tests/AutomationManagerTests.m').read_text()
+old='initWithWrap:[NSObject new] routeName:@"recording"'
+assert manager_fixture.count(old)==1
+manager_fixture='id CSAutomationPatDiagnosticOutputWrap(NSString *target);\n'+manager_fixture.replace(old,'initWithWrap:CSAutomationPatDiagnosticOutputWrap(target) routeName:@"recording"',1)
+(output/'AutomationManagerDiagnosticsFixture.m').write_text(manager_fixture)
+assert source.count('#import "AutomationManagerTests.m"')==1
+source=source.replace('#import "AutomationManagerTests.m"','#import "AutomationManagerDiagnosticsFixture.m"',1)
+marker='int main(int argc,const char **argv)'
+assert source.count(marker)==1
+source=source.replace(marker,'int CSAutomationDiagnosticPatBaselineMain(int argc,const char **argv)',1)
+# Observe the existing fixture's 2s due time and 5s retry through the helper's
+# test clock. The manager clock, original sends, claims and assertions stay intact.
+for old,new in [
+ ('contactsAvailable=NO;Advance(ingressManager,2);','contactsAvailable=NO;CSAutoDiagSetTestTime(2);Advance(ingressManager,2);'),
+ ('contactsAvailable=YES;Advance(ingressManager,5);','contactsAvailable=YES;CSAutoDiagSetTestTime(7);Advance(ingressManager,5);')]:
+ assert source.count(old)==1
+ source=source.replace(old,new,1)
+(output/'PatDiagnosticBaselineUnderTest.inc').write_text(source)
+PY
+xcrun --sdk macosx clang -fobjc-arc -fblocks -Wall -Wextra -Werror \
+  -DCS_AUTODIAG_HOST_TEST=1 -Wno-incomplete-implementation -Wno-unused-function \
+  -I"$project_dir/Tests/AIDetailUIKit" -I"$project_dir/Tests" -I"$project_dir/Controllers" -I"$project_dir/Headers" -I"$test_dir" -framework Foundation \
+  "$project_dir/Controllers/CSAutomationStore.m" "$project_dir/Controllers/CSAutomationManager.m" "$project_dir/Controllers/CSBackgroundSyncBudget.m" \
+  "$project_dir/Controllers/CSAutomationDiagnostics.m" "$test_dir/EventAdapterUnderTest.m" "$test_dir/NativeDispatchUnderTest.m" \
+  "$test_dir/AutomationIngressUnderTest.m" "$project_dir/Tests/AutomationPatDiagnosticsIntegrationTests.m" -o "$test_dir/tests"
+CS_AUTOMATION_TEST_ROOT="$test_dir/resources" "$test_dir/tests" "$test_dir/resources"
