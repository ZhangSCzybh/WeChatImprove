+static void RegisterService(NSString *mode) {
+    if([mode isEqual:@"class-missing"])return;
+    const char *performTypes="v@::@B";
+    if([mode isEqual:@"perform-result-B"])performTypes="B@::@B";
+    else if([mode isEqual:@"perform-selector-object"])performTypes="v@:@@B";
+    else if([mode isEqual:@"perform-object-i"])performTypes="v@::iB";
+    else if([mode isEqual:@"perform-wait-I"])performTypes="v@::@I";
+    else if([mode isEqual:@"perform-count"])performTypes="v@::@";
+    CHECK(class_addMethod(OnlineNativeService.class,NSSelectorFromString(@"performSelectorOnMainThread:withObject:waitUntilDone:"),(IMP)OnlinePerform,performTypes));
+    serviceClass=objc_allocateClassPair(OnlineNativeService.class,"NewSyncService",0);CHECK(serviceClass);
+    const char *types="v@:i";
+    if([mode isEqual:@"result-B"])types="B@:i";
+    else if([mode isEqual:@"argument-I"])types="v@:I";
+    else if([mode isEqual:@"argument-q"])types="v@:q";
+    else if([mode isEqual:@"argument-object"])types="v@:@";
+    else if([mode isEqual:@"count-zero"])types="v@:";
+    else if([mode isEqual:@"count-extra"])types="v@:ii";
+    if(![mode isEqual:@"selector-missing"])CHECK(class_addMethod(serviceClass,NSSelectorFromString(@"sendBgFgRequestWithOnlineMode:"),(IMP)OnlineSend,types));
+    for(NSString *prefix in @[@"longlink",@"sendonly"]){
+        if([mode isEqual:[prefix stringByAppendingString:@"-missing"]])continue;
+        const char *addTypes="v@:@";
+        if([mode isEqual:[prefix stringByAppendingString:@"-result-B"]])addTypes="B@:@";
+        else if([mode isEqual:[prefix stringByAppendingString:@"-argument-i"]])addTypes="v@:i";
+        else if([mode isEqual:[prefix stringByAppendingString:@"-count"]])addTypes="v@:";
+        NSString *selector=[prefix isEqual:@"longlink"]?@"addBgFgLongLinkEvent:":@"addBgFgSendOnlyEvent:";
+        CHECK(class_addMethod(serviceClass,NSSelectorFromString(selector),(IMP)OnlineAdd,addTypes));
+    }
+    objc_registerClassPair(serviceClass);
+}
