+    if (result!=CSMessageActionSubmissionStateAccepted && result!=CSMessageActionSubmissionStateUnknown && result!=CSMessageActionSubmissionStateFailedBeforeAcceptance) result=CSMessageActionSubmissionStateUnknown;
