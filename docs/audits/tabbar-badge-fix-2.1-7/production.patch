+static void CSLayoutNativeItem(MMTabBarItemView *item, CSTabBarItemState *s) {
+    // Parent resizing can move the native icon without moving its sibling badge.
+    // Keep nested hooks inside this transaction while both native anchors settle.
+    s.depth++;
+    @try {
+        [UIView performWithoutAnimation:^{ [item layoutIcon]; [item layoutBadgeView]; }];
+    } @finally {
+        s.depth--;
+    }
+}
+static CGRect CSConstrainBadgePosition(CGRect frame, CGRect native, CGRect bounds) {
+    // Preserve native overflow at this item width; constrain only added overflow.
+    CGFloat minX=MIN(CGRectGetMinX(bounds),CGRectGetMinX(native));
+    CGFloat maxX=MAX(CGRectGetMaxX(bounds),CGRectGetMaxX(native))-CGRectGetWidth(frame);
+    CGFloat minY=MIN(CGRectGetMinY(bounds),CGRectGetMinY(native));
+    CGFloat maxY=MAX(CGRectGetMaxY(bounds),CGRectGetMaxY(native))-CGRectGetHeight(frame);
+    BOOL constrainX=frame.origin.x<minX || frame.origin.x>maxX;
+    BOOL constrainY=frame.origin.y<minY || frame.origin.y>maxY;
+    if (!constrainX && !constrainY) return frame;
+    CGFloat scale=MAX(1,UIScreen.mainScreen.scale);
+    if (constrainX) {
+        CGFloat lower=ceil(minX*scale-1e-6)/scale, upper=floor(maxX*scale+1e-6)/scale;
+        frame.origin.x=lower<=upper ? MIN(upper,MAX(lower,frame.origin.x)) : native.origin.x;
+    }
+    if (constrainY) {
+        CGFloat lower=ceil(minY*scale-1e-6)/scale, upper=floor(maxY*scale+1e-6)/scale;
+        frame.origin.y=lower<=upper ? MIN(upper,MAX(lower,frame.origin.y)) : native.origin.y;
+    }
+    return frame;
+}
