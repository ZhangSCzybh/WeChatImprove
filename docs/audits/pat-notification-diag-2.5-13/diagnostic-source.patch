+static NSString *CSDiagKey(unsigned long long serverID,NSUInteger epoch) {
+    if(!serverID)return @"";
+    // Only the salted digest is retained. Neither the raw SID nor the salt is
+    // exported. A new capture uses a new salt and cannot be joined to the old.
+    uint8_t bytes[sizeof(CSDiagSalt)+sizeof(serverID)+sizeof(epoch)],digest[CC_SHA256_DIGEST_LENGTH];
+    memcpy(bytes,CSDiagSalt,sizeof(CSDiagSalt));memcpy(bytes+sizeof(CSDiagSalt),&serverID,sizeof(serverID));
+    memcpy(bytes+sizeof(CSDiagSalt)+sizeof(serverID),&epoch,sizeof(epoch));
+    CC_SHA256(bytes,(CC_LONG)sizeof(bytes),digest);
+    return [NSString stringWithFormat:@"%02x%02x%02x%02x%02x%02x%02x%02x",digest[0],digest[1],digest[2],digest[3],digest[4],digest[5],digest[6],digest[7]];
+}
