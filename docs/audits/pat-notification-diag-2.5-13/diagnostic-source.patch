+        if(!metadata || ![metadata.from isEqual:account] || ![metadata.to isEqual:conversation])return;
+        os_unfair_lock_lock(&CSDiagLock);
+        @try {
+            if(!CSDiagReplyCurrentLocked(generation) || CSDiagReplies.count>=CSDiagMaximumReplies)return;
+            for(CSDiagReplyEntry *entry in CSDiagReplies){
+                if(entry.epoch==epoch && entry.patServer==server && entry.wrap==wrap && CSDiagReplyMatch(entry,metadata,wrap))return;
