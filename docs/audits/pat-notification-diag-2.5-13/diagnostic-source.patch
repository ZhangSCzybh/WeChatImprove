+}
+void CSAutoDiagRecord(NSString *stage,unsigned long long serverID,NSUInteger epoch,uint64_t flags) {
+    if(!CSAutoDiagIsActive())return;
+    // Diagnostics must never unwind through an original/native call.
+    os_unfair_lock_lock(&CSDiagLock);
+    @try {
+        CSDiagAppendLocked(stage,serverID,epoch,flags);
+    }@catch(__unused NSException *exception) {CSDiagSetActive(NO);CSDiagStopReason=@"record_error";CSDiagStopped=CSDiagNow();}
+    @finally {os_unfair_lock_unlock(&CSDiagLock);}
+}
+static unsigned long long CSDiagEventServerID(NSDictionary *event) {
+    if(!CSAutoDiagIsActive())return 0;
+    @try {
+        if(![event isKindOfClass:NSDictionary.class])return 0;
+        id identifiers=event[@"identifiers"];if(![identifiers isKindOfClass:NSArray.class])return 0;
+        // Inspect the existing immutable event only; never source.serverId.
