+            if(![identifier isKindOfClass:NSString.class])continue;
+            NSRange range=[identifier rangeOfString:@"|pat:" options:NSBackwardsSearch];
+            if(range.location==NSNotFound)continue;
+            NSString *number=[identifier substringFromIndex:NSMaxRange(range)];
+            if(!number.length || number.length>20)return 0;
+            for(NSUInteger i=0;i<number.length;i++){unichar c=[number characterAtIndex:i];if(c<'0' || c>'9')return 0;}
+            errno=0;char *end=NULL;unsigned long long value=strtoull(number.UTF8String,&end,10);
