+@end
+@implementation CSDiagReplyToken @end
+static const NSUInteger CSDiagMaximumReplies=128;
+static BOOL CSDiagReplyCurrentLocked(NSUInteger generation) {
+    CSDiagExpireLocked(CSDiagNow());
+    return CSAutoDiagIsActive() && generation && generation==CSDiagGeneration;
+}
+static BOOL CSDiagReplyCurrent(NSUInteger generation) {
+    if(!CSAutoDiagIsActive())return NO;
+    os_unfair_lock_lock(&CSDiagLock);
+    BOOL current=CSDiagReplyCurrentLocked(generation);
+    os_unfair_lock_unlock(&CSDiagLock);return current;
+}
+static NSUInteger CSDiagReplyGeneration(NSUInteger epoch,BOOL needsEntry,BOOL needsCapacity) {
+    if(!CSAutoDiagIsActive())return 0;
+    os_unfair_lock_lock(&CSDiagLock);
+    @try {
+        if(!CSDiagReplyCurrentLocked(CSDiagGeneration) || (needsCapacity && CSDiagReplies.count>=CSDiagMaximumReplies))return 0;
+        if(needsEntry){
+            BOOL found=NO;
+            for(CSDiagReplyEntry *entry in CSDiagReplies)if(entry.epoch==epoch && entry.generation==CSDiagGeneration){found=YES;break;}
+            if(!found)return 0;
+        }
+        return CSDiagGeneration;
+    }@finally {os_unfair_lock_unlock(&CSDiagLock);}
+}
+static id CSDiagReplyRead(id message,NSString *name,NSString *type,NSUInteger generation) {
+    if(!CSDiagReplyCurrent(generation) || !CSMessageNativeSupports(message,name,type,@[]) || !CSDiagReplyCurrent(generation))return nil;
+    return CSMessageNativeInvoke(message,name,@[]);
+}
+static NSString *CSDiagReplyString(id value) {
+    return [value isKindOfClass:NSString.class] && [value length]>0 && [value length]<=512?[value copy]:nil;
+}
+static CSDiagReplyMetadata *CSDiagReplyReadMetadata(id message,NSUInteger generation) {
+    if(!message || !CSDiagReplyCurrent(generation))return nil;
+    CSDiagReplyMetadata *metadata=[CSDiagReplyMetadata new];
+    metadata.from=CSDiagReplyString(CSDiagReplyRead(message,@"m_nsFromUsr",@"@",generation));
+    if(!metadata.from)return nil;
+    metadata.to=CSDiagReplyString(CSDiagReplyRead(message,@"m_nsToUsr",@"@",generation));
+    if(!metadata.to)return nil;
+    metadata.created=[CSDiagReplyRead(message,@"m_uiCreateTime",@"I",generation) unsignedIntValue];
+    metadata.local=[CSDiagReplyRead(message,@"m_uiMesLocalID",@"I",generation) unsignedIntValue];
+    long long server=[CSDiagReplyRead(message,@"m_n64MesSvrID",@"q",generation) longLongValue];
+    metadata.server=server>0?(unsigned long long)server:0;
+    metadata.client=CSDiagReplyString(CSDiagReplyRead(message,@"m_nsClientMsgID",@"@",generation));
+    return CSDiagReplyCurrent(generation)?metadata:nil;
+}
+static uint64_t CSDiagReplyPresence(CSDiagReplyMetadata *metadata) {
+    return (metadata.local?(1ULL<<2):0) | (metadata.server?(1ULL<<3):0) | (metadata.client.length?(1ULL<<4):0);
+}
+static uint64_t CSDiagReplyMatch(CSDiagReplyEntry *entry,CSDiagReplyMetadata *metadata,id message) {
+    CSDiagReplyMetadata *known=entry.metadata;
+    // Even a matching numeric/client alias cannot bridge a different envelope.
+    // Conflicting nonempty aliases are never resolved by choosing a stronger ID.
+    if(![known.from isEqual:metadata.from] || ![known.to isEqual:metadata.to] ||
+       (known.created && metadata.created && known.created!=metadata.created) ||
+       (known.local && metadata.local && known.local!=metadata.local) ||
+       (known.server && metadata.server && known.server!=metadata.server) ||
+       (known.client.length && metadata.client.length && ![known.client isEqual:metadata.client]))return 0;
+    uint64_t flags=0;
+    BOOL creation=known.created && known.created==metadata.created;
+    if(entry.wrap==message && creation)flags|=1ULL<<5;
+    if(known.local && known.local==metadata.local && creation)flags|=1ULL<<6;
+    if(known.server && known.server==metadata.server)flags|=1ULL<<7;
+    if(known.client.length && [known.client isEqual:metadata.client])flags|=1ULL<<8;
+    return flags;
+}
+static CSDiagReplyEntry *CSDiagReplyFindLocked(CSDiagReplyMetadata *metadata,id message,NSUInteger epoch,NSUInteger generation,uint64_t *match,BOOL *ambiguous) {
+    CSDiagReplyEntry *found=nil;uint64_t foundMatch=0;
+    for(CSDiagReplyEntry *entry in CSDiagReplies){
+        if(entry.epoch!=epoch || entry.generation!=generation)continue;
+        uint64_t flags=CSDiagReplyMatch(entry,metadata,message);
+        if(!flags)continue;
+        if(found){if(ambiguous)*ambiguous=YES;return nil;} // Two tasks: fail closed.
+        found=entry;foundMatch=flags;
+    }
+    if(match)*match=foundMatch;return found;
+}
+static void CSDiagReplyMerge(CSDiagReplyEntry *entry,CSDiagReplyMetadata *metadata,id message) {
+    CSDiagReplyMetadata *known=entry.metadata;
+    if(!known.local)known.local=metadata.local;
+    if(!known.created)known.created=metadata.created;
+    if(!known.server)known.server=metadata.server;
+    if(!known.client.length)known.client=metadata.client;
+    entry.wrap=message;
+}
+void CSAutoDiagReplyTrack(id wrap,NSDictionary *patEvent,NSUInteger epoch) {
+    if(!CSAutoDiagIsActive())return;
+    @try {
