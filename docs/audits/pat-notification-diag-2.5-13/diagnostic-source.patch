+// Temporary diag.2 observer. Message observation is a no-op when inactive.
+// Track immediately before the native submit and Update immediately after it.
+// Only normalized pat events are tracked; no native service or setter is used.
+FOUNDATION_EXPORT void CSAutoDiagReplyTrack(id wrap, NSDictionary *patEvent, NSUInteger epoch);
+FOUNDATION_EXPORT void CSAutoDiagReplyUpdate(id wrap, NSUInteger epoch);
+// Invoke Begin before the existing success/failure original. End consumes only
+// its cached token, even if the original threw or replaced/mutated its argument.
+FOUNDATION_EXPORT id CSAutoDiagReplyCallbackBegin(id message, BOOL success, NSUInteger epoch);
+FOUNDATION_EXPORT void CSAutoDiagReplyCallbackEnd(id token, BOOL originalReturned);
+// Cached scalar capability only. Start reports each selector whose installation
+// has been attempted; calling this never forces native initialization.
+FOUNDATION_EXPORT void CSAutoDiagReplyHookState(BOOL success, BOOL installed);
+
+// reply.track/update/callback flags: bit 0 success selector (callbacks only),
+// bit 1 original returned (end only), bit 2 local ID present, bit 3 server ID
+// present, bit 4 client ID present, bit 5 exact wrapper + creation time match,
+// bit 6 local ID + creation time match, bit 7 server ID match, bit 8 client ID
+// match. reply.hook.state: bit 0 success selector, bit 1 installed.
+// IDs and envelope strings exist only in a maximum of 128 memory entries.
+// Callback records retain the originating capture generation and account epoch.
+// reply.callback.unmatched has an empty key; bits 0/2/3/4 have the same meaning,
+// bit 9 marks multiple matching tasks. It is limited to eight per selector per
+// capture, and is omitted without tracked entries for the supplied epoch.
+
+#if CS_AUTODIAG_HOST_TEST
+FOUNDATION_EXPORT NSUInteger CSAutoDiagReplyTrackedCountForTest(void);
+#endif
+
