+// This registry shares the capture lock and generation with the recorder. No
+// native getter runs under that lock: a stopped/restarted capture invalidates
+// the metadata read before it can be committed or turned into a callback token.
+@interface CSDiagReplyMetadata : NSObject
+@property(nonatomic,copy) NSString *from,*to,*client;
+@property(nonatomic) unsigned int local,created;
+@property(nonatomic) unsigned long long server;
+@end
+@implementation CSDiagReplyMetadata @end
+@interface CSDiagReplyEntry : NSObject
+@property(nonatomic,strong) CSDiagReplyMetadata *metadata;
+@property(nonatomic,weak) id wrap;
+@property(nonatomic) unsigned long long patServer;
+@property(nonatomic) NSUInteger epoch,generation;
+@end
+@implementation CSDiagReplyEntry @end
+@interface CSDiagReplyToken : NSObject
+@property(nonatomic) unsigned long long patServer;
