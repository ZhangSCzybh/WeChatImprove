    "primaryContentSections": [
      {
        "details": {
          "name": "UIDesignRequiresCompatibility",
          "platforms": [],
          "titleStyle": "symbol",
          "value": [
            {
              "arrayMode": false,
              "baseType": "boolean"
            }
          ]
        },
        "kind": "details",
        "title": "Details"
      },
      {
        "content": [
          {
            "anchor": "Discussion",
            "level": 2,
            "text": "Discussion",
            "type": "heading"
          },
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "Temporarily use this key while reviewing and refining your app’s UI for the design in the latest SDKs.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "name": "Warning",
            "style": "warning",
            "type": "aside"
          },
          {
            "inlineContent": [
              {
                "text": "If ",
                "type": "text"
              },
              {
                "code": "YES",
                "type": "codeVoice"
              },
              {
                "text": ", the system runs the app using a compatibility mode for UI elements. The compatibility mode displays the app as it looks when built against previous versions of the SDKs.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "If ",
                "type": "text"
              },
              {
                "code": "NO",
                "type": "codeVoice"
              },
              {
                "text": ", the system uses the UI design of the running OS, with no compatibility mode. Absence of the key, or ",
                "type": "text"
              },
              {
                "code": "NO",
                "type": "codeVoice"
              },
              {
                "text": ", is the default value for apps linking against the latest SDKs.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "The system ignores this key when you build for iOS 27 or later, iPadOS 27 or later, Mac Catalyst 27 or later, macOS 27 or later, or tvOS 27 or later.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        "kind": "content"
      }
    ],
